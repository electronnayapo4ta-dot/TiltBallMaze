<resources>

    <style name="GameButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">200dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">@color/btn_primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:padding">12dp</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:stateListAnimator">@animator/button_glow</item>
    </style>

    <style name="LevelButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">160dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">@color/btn_level</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:stateListAnimator">@animator/button_glow</item>
    </style>

</resources>
